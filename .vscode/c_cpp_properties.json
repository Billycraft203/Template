{
  "version": 4,
  "configurations": [
    {
      "name": "STM32F103ZE（Keil ARMCC5 工程，供 IntelliSense 解析）",
      "includePath": [
        "${workspaceFolder}/USER",
        "${workspaceFolder}/CMSIS",
        "${workspaceFolder}/FWLlib/inc",
        "${workspaceFolder}/BSP",
        "${workspaceFolder}/UTILS",
        "${workspaceFolder}/APP",
        "C:/Keil_v5/ARM/ARMCLANG/include"
      ],
      "compilerPath": "C:/Keil_v5/ARM/ARMCLANG/bin/armclang.exe",
      "compilerArgs": [
        "--target=arm-arm-none-eabi",
        "-mcpu=cortex-m3"
      ],
      "intelliSenseMode": "windows-clang-arm",
      "defines": [
        "STM32F10X_HD",
        "USE_STDPERIPH_DRIVER"
      ],

      "cStandard": "c99",
      "browse": {
        "path": [
          "${workspaceFolder}/USER",
          "${workspaceFolder}/CMSIS",
          "${workspaceFolder}/FWLlib/inc",
          "${workspaceFolder}/UTILS",
          "${workspaceFolder}/APP",
          "${workspaceFolder}/BSP"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
