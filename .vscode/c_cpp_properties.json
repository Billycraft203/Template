{
  "version": 4,
  "configurations": [
    {
      "name": "STM32F103ZE（Keil 工程，仅用于编辑器解析）",
      "includePath": [
        "${workspaceFolder}/USER",
        "${workspaceFolder}/CMSIS",
        "${workspaceFolder}/FWLlib/inc",
        "${workspaceFolder}/BSP"
      ],
      "defines": [
        "STM32F10X_HD",
        "USE_STDPERIPH_DRIVER"
      ],
      "cStandard": "c99",
      "browse": {
        "path": [
          "${workspaceFolder}/USER",
          "${workspaceFolder}/CMSIS",
          "${workspaceFolder}/FWLlib",
          "${workspaceFolder}/BSP"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}